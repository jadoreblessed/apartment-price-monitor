# Local SQLite database stored in prisma/dev.db.
DATABASE_URL="file:./dev.db"
# Set to 1 only when the site is served over HTTPS.
AUTH_SECURE_COOKIE="0"

# Optional proxy used by the Avito browser for the whole monitoring run.
PROXY_SERVER="http://mobpool.proxy.market:10000"
PROXY_USERNAME=""
PROXY_PASSWORD=""
